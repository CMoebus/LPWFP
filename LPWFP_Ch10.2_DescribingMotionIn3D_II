# ╔═╡ b39c65fa-6ea1-4dbc-8a59-d1d2ec49757f
function shiftIntoOrigin(v::Vector{NTuple{N, Float64}}) where {N}
	[subtractTuple(v[1], v[1]), subtractTuple(v[2], v[1])]::Vector{NTuple{N, Float64}}
end # function shiftIntoOrigin

# ╔═╡ 32583cda-66ca-4c6f-a418-cd2b9ac2c786
function alignTailToTail(v1::Vector{NTuple{N, Float64}}, v2::Vector{NTuple{N, Float64}}) where {N}
	[(addTuple(v1[1], shiftIntoOrigin(v2)[1])), 
	 (addTuple(v1[1], shiftIntoOrigin(v2)[2]))]::Vector{NTuple{N, Float64}}
end # function alignTailToTail

# ╔═╡ 16df17c0-1990-47a9-bb28-8d8d8fe4905d
function alignHeadToTail(v1::Vector{NTuple{N, Float64}}, v2::Vector{NTuple{N, Float64}}) where {N}
	[(addTuple(v1[2], shiftIntoOrigin(v2)[1])), 
	 (addTuple(v1[2], shiftIntoOrigin(v2)[2]))]::Vector{NTuple{N, Float64}}
end # function alignHeadToTail

