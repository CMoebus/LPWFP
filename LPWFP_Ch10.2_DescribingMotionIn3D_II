# ╔═╡ 5c402a7e-2721-47a5-a898-6f33ec39fe12
function scale(v::Vector{NTuple{N, Float64}}, s::Number) where {N}
	Δx = head(v)[1] - tail(v)[1]
	Δy = head(v)[2] - tail(v)[2] 
	#--------------------------------------------------
	magnitude(v) = sqrt(Δx^2 + Δy^2)
	direction(v) = atan(Δy, Δx)
	makeHeadScaled(v, xScaled, yScaled) = 
		(tail(v)[1] + xScaled, tail(v)[2] + yScaled)
	#--------------------------------------------------
	r  = magnitude(v)
	θ  = direction(v)
	xScaled = r*cos(θ)*s
	yScaled = r*sin(θ)*s
	[tail(v), makeHeadScaled(v, xScaled, yScaled)]::Vector{NTuple{N, Float64}}
end # function scale

