v43DGLM = vect_From_PtoQ_to_QminP(v43D)  # 4th edge of pyramid

# ╔═╡ 30fd7201-19be-4d3d-9ef2-67e264d54c83
echs = head(ecGLM)     # start point P; vector Q-P

# ╔═╡ 677862aa-d808-42cc-83ca-ec32bafdd196
let eits  = tail(eiGLM);         eihs = head(eiGLM)      # start point P; vector Q-P
	ejts  = tail(ejGLM);         ejhs = head(ejGLM)      # start point P; vector Q-P
	ekts  = tail(ekGLM);         ekhs = head(ekGLM)      # start point P; vector Q-P
	#--------------------------------------------------------------------------------
	ects  = tail(ecGLM);         echs = head(ecGLM)      # start point P; vector Q-P
	eiSts = tail(eiGLMShifted); eiShs = head(eiGLMShifted)
	ejSts = tail(ejGLMShifted); ejShs = head(ejGLMShifted)
	#--------------------------------------------------------------------------------
	v13DGLMts = tail(v13DGLM); v13DGLMhs = head(v13DGLM) # edge 1 of pyramid
	v23DGLMts = tail(v23DGLM); v23DGLMhs = head(v23DGLM) # edge 2 of pyramid
	v33DGLMts = tail(v33DGLM); v33DGLMhs = head(v33DGLM) # edge 3 of pyramid
	v34DGLMts = tail(v43DGLM); v43DGLMhs = head(v43DGLM) # edge 4 of pyramid
	#--------------------------------------------------------------------------------
	fig = Figure()
	ax  = Axis3(
			fig[1,1], 
			title  = L"Base\ Vectors\ e_i, e_j, e_k\ and\ centre\ vector\ e_c\ in\ \mathbb R^3", 
			titlesize=20,
			aspect = :data)
	limits!(ax, -0.02, 1.02, -0.02, 1.02, -0.02, 1.02)
	#--------------------------------------------------------------------------------
	# start points; important f.([...])
	points  = 
		Point3f.([eits, ejts, ekts, ects, eiSts, ejSts, v13DGLMts, v23DGLMts, v33DGLMts, v34DGLMts])  
	# vectors Q-P;  important f.([...])
	vectors =   
		Vec3f.([eihs, ejhs, ekhs, echs, eiShs, ejShs, v13DGLMhs, v23DGLMhs, v33DGLMhs, v43DGLMhs])  
	#--------------------------------------------------------------------------------
	text!(ax, L"e_i", position = Point3f(eihs), align = (:left, :bottom),
		fontsize = 18)
	text!(ax, L"e_j", position = Point3f(ejhs), align = (:left, :bottom),
		fontsize = 18)
	text!(ax, L"e_k", position = Point3f(ekhs), align = (:left, :bottom),
		fontsize = 18)
	text!(ax, L"e_c", position = Point3f(echs), align = (:left, :bottom),
		fontsize = 18)
	#--------------------------------------------------------------------------------
	arrows3d!(
		ax,
		points, 
		vectors, 
		color       = 
			[:lightgreen, :lightgreen, :lightgreen, :gold, :green, :green, :red, :red, :red, :red],
		tipradius   = 0.015,
		tiplength   = 0.10,
	    shaftradius = 0.0025)
	ax.azimuth[]    =  -π/3
	ax.elevation[]  =   π/6
	#--------------------------------------------------------------------------------
	fig
end # let

