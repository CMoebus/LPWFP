# ╔═╡ 92e51a49-288a-4d29-b191-f2d22527ec76
function oneStep(f, Δx, (x, y))            # <------------------- 1st method
	xΔx = x + Δx
	yΔx = y + f(x) * Δx 
	(xΔx, yΔx)
end # function oneStep

