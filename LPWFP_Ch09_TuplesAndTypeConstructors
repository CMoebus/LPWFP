# ╔═╡ 4e54eebe-f2a9-4548-bc90-1700826df950
function myIntegralAlt(f::Function, n::Int64, a::Float64, b::Float64)::Float64
	Δx  = abs(a - b)/n
	yΔx = 0.0
	#---------------------------------------------------------------------------
	for x in a:Δx:b-Δx
		yΔx = yΔx + oneStep(Δx, f(x+Δx/2.0))
	end # for
	#---------------------------------------------------------------------------
	yΔx
end # function myIntegral

