###### 3.9.2 Pure Functional with $reduce$
Beware of the *correct associativity* (= right ordering of operations) !

$(x, y) \rightarrow x + f(y+Δx/2)*Δx \neq (x, y) \rightarrow f(x+Δx/2)*Δx + y$

The correct ordering is *right associative*:

$(x, y) \rightarrow x + f(y+Δx/2)*Δx.$

"

# ╔═╡ 9cadb25a-d15a-46a1-8760-4d1510a6c053
function myIntegralRedu(
	f::Function, n::Int, a::Float64, b::Float64; init=0.0)::Float64
	Δx  = abs(a - b)/n
	#     +--------------------+---------------------------- generator (!)
	#     |                    |
	#     v                    v
	xs  = (x for x in a:Δx:b-Δx)
	#       +--+-------------------------------------------- 2-arg function
	#       |  |     +---------+---------------------------- correct order
	#       |  |     |         |                             (=right associativity)
	#       v  v     v         v
	reduce((x, y) -> x + f(y+Δx/2)*Δx, xs, init = init)
end # function myIntegralRedu

