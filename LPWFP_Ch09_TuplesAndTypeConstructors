# ╔═╡ 27972445-a44f-4c9f-a6ae-a03dbf89763a
function myIntegral(f::Function, n::Int, a::Float64, b::Float64)::Float64
	Δx = abs(a - b)/n
	#   +-----------------------------+---------------------------- generator
	#   |                             |
	#   |                        +----|---------------------------- midpoint rule
	#   |                        |    |
	#   v                        v    v
	sum((oneStep(f, Δx, (lb, f(Δx/2.0)))[2] for lb in a:Δx:b-Δx))
end # function myIntegral

