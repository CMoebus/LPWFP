# ╔═╡ a469ebd4-65bf-4c16-96f8-3534c156307f
const Maybe{T} = Union{T, Nothing} where {T <: Any}

# ╔═╡ 6124f2ab-634c-44e6-b7a0-f84285815142
just(xs::Vector)::Maybe = xs

# ╔═╡ 2adc071e-a136-44ce-9a5e-2dc859a612c3
typeof(Maybe)

# ╔═╡ dca28107-d39a-4906-898e-3f63481f005c
function findFirst(pred, xs) 
	xsFiltered = collect(Iterators.dropwhile(x -> !pred(x), xs))
	if  xsFiltered == []
		Nothing
	else
		xsFiltered
	end # if
end # function findFirst

# ╔═╡ 344b7331-6790-4135-aa36-ef565927fcd2
typeof(findFirst)

# ╔═╡ 587e120b-49e7-4739-b8fd-21d4116cd0d2
function findFirstMaybe(pred::Function, xs::Vector)::Maybe
	xsFiltered = collect(Iterators.dropwhile(x -> !pred(x), xs))
	if  xsFiltered == []
		Nothing
	else
		just(xsFiltered)
	end # if
end # function findFirstMaybe

