###### 3.3 Composing Functions and Pipelining 
(cf. Walck, 2020, p21f)

$(g \circ f)(x) = g(f(x))$
$x \; \text{|>} \; f \; \text{|>} \; g = g(f(x))$
"

# ╔═╡ 1e0547bc-dbe8-41b9-82e4-4d2eefc88ded
begin 
	square(x) = x * x
	cosSq1(x) = square(cos(x))
	cosSq1(x::Float64)::Float64 = square(cos(x))
end

# ╔═╡ 90d52650-876e-43f7-bebd-d43aefc5fcb1
cosSq1(x)

# ╔═╡ 85e852d9-7d63-4aa7-b7f0-0b6dd18670b1
begin 
	cosSq2(x) = (square ∘ cos)(x)
	cosSq2(x::Float64)::Float64 = (square ∘ cos)(x)
end

# ╔═╡ 59367034-5c6c-4bd5-8120-f25f2da4ca8c
cosSq2(x)

# ╔═╡ b07cb189-b124-45d8-b8d6-50e5363d5c13
begin 
	cosSq3(x) =  x |> cos |> square
	cosSq3(x::Float64)::Float64 = x |> cos |> square
end

# ╔═╡ bc27a13b-8f30-467f-8882-dd1e7ec849b3
cosSq3(x)

