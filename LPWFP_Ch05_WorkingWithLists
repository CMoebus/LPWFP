# ╔═╡ a7d0e81a-44b9-4275-8967-cfd1a9e2ab1e
function sndItem(ys::Vector) 
	if length(ys) == 0
		"error: empty vector has no second element!"
	elseif length(ys) == 1
		"error: one-element vector has no second element!"
	else 
		ys[2]
	end # if
end # function sndItem

# ╔═╡ 0be1d0b9-22fd-407c-9f6c-fafe0fdd9817
sndItem([8, 6, 7, 5])

# ╔═╡ b02a5590-4088-469e-bdce-931772232695
function sndItem2(ys::Vector) 
	if length(ys) ≤ 1
		"error: vector has no second element!"
	else 
		ys[2]
	end # if
end # function sndItem2

