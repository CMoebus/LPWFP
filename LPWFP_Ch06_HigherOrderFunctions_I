# ╔═╡ d77bbfd0-8a77-4d95-abfe-c9941b57cf56
md"
Now we determine the smallest step size $Δt$ such that the value of the *numerical* integral is no longer distinguishable from the value $1/3$ of the *analytical* integral. As we see the smallest step size is $Δt = 4.76837e-9$.
"

# ╔═╡ 0327edf7-1420-48b4-8472-409c2972c549
let Δt = 0.01                           # how small should Δt shrink ?
	while abs(myIntegral(x -> x^2, Δt, 0.0, 1.0) - 1/3) > 1.0E-17
		println(myIntegral(x -> x^2, Δt, 0.0, 1.0))
		Δt /= 2.0
	end # while
	Δt, myIntegral(x -> x^2, Δt, 0.0, 1.0)  # Δt-min = 4.76837e-9
end # let

