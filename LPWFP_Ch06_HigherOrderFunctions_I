	#                 +------------------------------------------------ function (!)
	#                 |
	#                 v
	Fvels  = [velocityFromAcceleration(f, Δτ, 0.0, τ, c=0.0) for τ in τs]
	#--------------------------------------------------------------------------------
	# Fvs = antiderivative from vector of function values f(t)
	Fvelvs = 
		[velocityFromAcceleration(
	#           +-------------------------+-------------+---------------- vector (!)
	#           |                         |             |
	#           v                         v             v
				[f(τ) for τ in 0.0:Δτ:τlim], Δτ, c=0.0)[1] for τlim in τs]
	#--------------------------------------------------------------------------------
	plot(xlimits=[-0.02, 11.02], ylimits=[-1.52, 1.56], title=L"Antiderivatives\ Fvels(τ), Fvelvs(τ)\ for\ f(τ)=acc(τ)=-cos(τ)", titlefontsize=12, xlabel=L"τ", ylabel=L"Fs(τ), Fvs(τ), Ts(τ)")
	#--------------------------------------------------------------------------------
	plot!(τs, τ->jerk(τ), lw=1.5, color=:red, label=L"theoretical\ j(τ)")
	plot!(τs, τ->acc(τ),  lw=1.5, color=:green, label=L"theoretical\ a(t)")
	plot!(τs, τ->vel(τ),  lw=1.0, color=:orange, label=L"theoretical\ v(t)")
	plot!(τs, τ->pos(τ),  lw=1.5, color=:blue, label=L"theoretical\ x(t)")
	#--------------------------------------------------------------------------------
	plot!(τs, Fvels, lw=1.5, linestyle=:dot, color=:orange, label=L"Fvels(τ) \approx c + \int_0^τ f_a(t) dt")
	plot!(τs, Fvelvs, lw=3.0, linestyle=:dashdot, color=:orange, label=L"Fvelvs(τ) \approx c + \Delta x \sum_{i=1}^n f_a[i]")
