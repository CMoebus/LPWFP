# ╔═╡ 82f1fd2a-fab2-4708-90b7-b1952ed66882
md"
---
###### 3.9.6 *Position* from *Velocity* in *Scotch-Yoke-Oscillator*

"

# ╔═╡ 2a85d4bd-6913-4b84-ad09-25af3361ce2c
md"
###### 1. *Method* of Function Antiderivative $F_x(t)$ with *Continuous* Function Parameter $f_x(t)$

$F_x(t) = x(t) = x(0) + \int_0^t f_v(t') dt' \approx c + \Delta t \sum_{i=1}^t f_v(t_i)\;;\; t_i \le t$

"

# ╔═╡ 2e08376d-d48c-4452-b335-8c5dd426abf2
# for continuous function vel
positionFromVelocity(
	velf::Function, Δt::Float64, a::Float64, t::Float64; c::Float64=0.0)::Float64 = 
	antiDerivative(velf, Δt, a, t, c = c)

# ╔═╡ de2d212e-4669-4b09-b149-1a8fb0cd6ef8
md"
###### 2. Method of Function Antiderivative $F(x)$ with *Vector* of Discretized *Function* Values 

$F_x(t) = x(t) = \int_0^t f_v(t') dt' \approx c + \Delta t \sum_{i=1}^n [...,f_v[i],...]$

"

# ╔═╡ 85f60a52-c682-49e0-ab72-2f2fa8095d9d
# for vector velV of discretisized function values vel
positionFromVelocity(velV::Vector{Float64}, Δt::Float64; c::Float64=0.0)::Tuple{Float64, Float64} = 
	antiDerivative(velV, Δt, c = c)

# ╔═╡ 48bd2212-a287-42fe-9f8e-aed731339e76
let Δτ      =  1.0E-3                         # should not be smaller than 1.0E-4 !
	τUpLim  =  2.0pi                          # upper integration limit τ
	τs      =  [τ for τ  in 0.0:Δτ:τUpLim]    # τUpLim/Δτ = n integration step points
	jerk(τ) =  sin(τ)                         # x'''(τ) = jerk in Scotch-Yoke-Oscill.
	acc(τ)  = -cos(τ)                         # acceleration
	vel(τ)  = -sin(τ)                         # velocity
	pos(τ)  =  cos(τ)                         # position 
	f(τ)    =  vel(τ)                         # integrand function f
	fs      =  [f(τ) for τ in τs]             # vector of function values f(τi)
	#--------------------------------------------------------------------------------
	# Fs = antiderivative from continuous function f(t)
	#                 +------------------------------------------------ function (!)
	#                 |
	#                 v
	Fposs  = [positionFromVelocity(f, Δτ, 0.0, τ, c=1.0) for τ in τs]
	#--------------------------------------------------------------------------------
	# Fvs = antiderivative from vector of function values f(t)
	Fposvs = 
		[positionFromVelocity(
	#           +-------------------------+-------------+---------------- vector (!)
	#           |                         |             |
	#           v                         v             v
				[f(τ) for τ in 0.0:Δτ:τlim], Δτ, c=1.0)[1] for τlim in τs]
	#--------------------------------------------------------------------------------
	plot(xlimits=[-0.02, 11.02], ylimits=[-1.52, 1.56], title=L"Antiderivatives\ Fposs(τ), Fposvs(τ)\ for\ f(τ)=vel(τ)=-sin(τ)", titlefontsize=12, xlabel=L"τ", ylabel=L"Fs(τ), Fvs(τ), Ts(τ)")
	#--------------------------------------------------------------------------------
	plot!(τs, τ->jerk(τ), lw=1.5, color=:red, label=L"theoretical\ j(τ)")
	plot!(τs, τ->acc(τ),  lw=1.5, color=:green, label=L"theoretical\ a(t)")
	plot!(τs, τ->vel(τ),  lw=1.0, color=:orange, label=L"theoretical\ v(t)")
	plot!(τs, τ->pos(τ),  lw=1.5, color=:blue, label=L"theoretical\ x(t)")
	#--------------------------------------------------------------------------------
	plot!(τs, Fposs, lw=2.5, linestyle=:dot, color=:cornflowerblue, label=L"Fposs(τ) \approx c + \int_0^τ f_v(τ) dτ")
	plot!(τs, Fposvs, lw=3.5, linestyle=:dashdot, color=:cornflowerblue, label=L"Fposvs(τ) \approx c + \Delta x \sum_{i=1}^n f_v[i]")
	#-------------------------------------------------------------------------------
end # let

