# ╔═╡ 8a11da66-9f5d-4009-9270-b0b39ca7a523
let Δτ      =  1.0E-3                         # should not be smaller than 1.0E-4 !
	τUpLim  =  2.0pi                          # upper integration limit τ
	τs      =  [τ for τ  in 0.0:Δτ:τUpLim]    # τUpLim/Δτ = n integration step points
	jerk(τ) =  sin(τ)                         # x'''(τ) = jerk in Scotch-Yoke-Oscill.
	acc(τ)  = -cos(τ)                         # acceleration
	vel(τ)  = -sin(τ)                         # velocity
	pos(τ)  =  cos(τ)                         # position 
	# f(τ)    =  vel(τ)                         # integrand function f
	# fs      =  [f(τ) for τ in τs]             # vector of function values f(τi)
	#--------------------------------------------------------------------------------
	# Fs = antiderivative from continuous function f(t)
	#                 +------------------------------------------------ function (!)
	#                 |
	#                 v
	Fas    = [accelerationFromJerk(jerk, Δτ, -1.5, τ, c=0.0) for τ in τs]
	Fvels  = [velocityFromAcceleration(acc, Δτ, 0.0, τ, c=0.0) for τ in τs]
	Fposs  = [positionFromVelocity(vel, Δτ, 0.0, τ, c=1.0) for τ in τs]
	#--------------------------------------------------------------------------------
	# Fvs = antiderivative from vector of function values f(t)
	Favs = 
		[accelerationFromJerk(
	#           +----------------------------+--------------+------------ vector (!)
	#           |                            |              |
	#           v                            v              v
				[jerk(τ) for τ in 0.0:Δτ:τlim], Δτ, c=-1.0)[1] for τlim in τs]
	#-----------------------------------------------------------------------------
	Fvelvs = 
		[velocityFromAcceleration(
	#           +---------------------------+-------------+-------------- vector (!)
	#           |                           |             |
	#           v                           v             v
				[acc(τ) for τ in 0.0:Δτ:τlim], Δτ, c=0.0)[1] for τlim in τs]
	#-----------------------------------------------------------------------------
	Fposvs = 
		[positionFromVelocity(
	#           +---------------------------+-------------+-------------- vector (!)
	#           |                           |             |
	#           v                           v             v
				[vel(τ) for τ in 0.0:Δτ:τlim], Δτ, c=1.0)[1] for τlim in τs]
	#--------------------------------------------------------------------------------
	plot(xlimits=[-0.02, 10.52], ylimits=[-1.52, 1.56], title=L"All\ Numerical\ Antiderivatives\ of\ Scotch-Yoke-Oscillator", titlefontsize=12, xlabel=L"τ", ylabel=L"Fs(τ), Fvs(τ), Ts(τ)") 
	#--------------------------------------------------------------------------------
	plot!(τs, τ->jerk(τ), lw=1.5, color=:red, label=L"theoretical\ f_j(τ)")
	# plot!(τs, τ->acc(τ),  lw=1.5, color=:green, label=L"theoretical\ a(t)")
	# plot!(τs, τ->vel(τ),  lw=1.0, color=:orange, label=L"theoretical\ v(t)")
	# plot!(τs, τ->pos(τ),  lw=1.5, color=:blue, label=L"theoretical\ x(t)")
	#--------------------------------------------------------------------------------
	plot!(τs, Fas, lw=2.5, linestyle=:dot, color=:green, label=L"F_a(τ) \approx \int_0^τ f_j(t) dt")
	plot!(τs, Favs, lw=1.5, linestyle=:dashdot, color=:green, label=L"F_a(τ) \approx c + \Delta x \sum_{i=1}^n f_j[i]")
	plot!(τs, Fvels, lw=1.5, linestyle=:dot, color=:orange, label=L"F_v(τ) \approx \int_0^τ f_a(t) dt")
	plot!(τs, Fvelvs, lw=3.0, linestyle=:dashdot, color=:orange, label=L"F_v(τ) \approx c + \Delta x \sum_{i=1}^n f_a[i]")
	plot!(τs, Fposs, lw=2.5, linestyle=:dot, color=:cornflowerblue, label=L"F_x(τ) \approx \int_0^τ f_v(τ) dτ")
	plot!(τs, Fposvs, lw=3.5, linestyle=:dashdot, color=:cornflowerblue, label=L"F_x(τ) \approx c + \Delta x \sum_{i=1}^n f_v[i]")
	#-------------------------------------------------------------------------------
end # let

# ╔═╡ 5cbc5c49-3b78-499d-a419-7ec57d52d6ba
md"""
---
##### 4. Summary
We kept close to chapter 6 of Walck's book but we substituted his *air car* example by the *Scotch-Yoke-Oscillator*. This has the advantage of computing a *hierarchy* of integration levels. We started with the time-dependent $jerk$ variable and computed its antiderivatives *acceleration* $F_a$, *velocity* $F_v$ and *position* $F_x$. 

The idea to include $jerk$ came when I watched the quiz show '*Who knows such things?*' ('*Wer weiß denn sowas?*') on german TV ARD in 1st December 2025. The concept *jerk* was presented in the question "*Jerk, the English word for ‘idiot’ or 'moron'*" (*Jerk, das englische Wort für 'Idiot' oder 'Trottel',..*"). Two guess teams and the public audience was presented a set of multiple choice answer alternatives: 

- A) "*...originally described villages where many bachelors lived.* (*...beschrieb ursprünglich Dörfer, in denen viele Junggesellen lebten.*") 
- B) "*...is considered traditional approval in debates in the British House of Commons.* (*...gilt im britischen Unterhaus bei Debatten als traditionelle Zustimmung.*")
- C) "*...corresponds to the physical quantity ‘jerk’ in mechanics.* (*...entspricht der physikalischen Größe 'Ruck' in der Mechanik.*")

We developed *two* alternative *methods* for the *function* $antiderivative$. The *first* method is close to Walck's Haskell method. It accepts *functional* arguments for the function $f$. The *second* method is *new*. It accepts a *vector* of function *values* instead of one *functional* argument.

"""

