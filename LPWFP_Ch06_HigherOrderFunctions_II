# ╔═╡ 83ceafd9-20e5-4329-a3ce-f6c757355986
md"
---
###### 3.2.3 The Totality of *Parallelized* Numerical *AntiDerivatives* of *Scotch-Yoke-Oscillator (SYO)*
"

# ╔═╡ 30ffe340-1193-42b7-80db-4d0b69495516
let nIntvs  =  10^3                           # number of intervals
	τUpLim  =  2.0pi                          # upper integration limit τ
	Δτ      =  abs(0.0-τUpLim)/nIntvs
	τs      =  [τ for τ in 0.0+Δτ/2:Δτ:τUpLim-Δτ/2] 
	jerk(τ) =  sin(τ)                         # x'''(τ) = jerk in Scotch-Yoke-Oscill.
	acc(τ)  = -cos(τ)                         # acceleration
	Fas(τ)  =  acc(τ)                         # acceleration
	vel(τ)  = -sin(τ)                         # velocity
	pos(τ)  =  cos(τ)                         # position 
	fjs     =  [jerk(τ) for τ in τs]          # vector of function values f(τi)
	fas     =  [acc(τ) for τ in τs]           # vector of function values f(τi)
	fvs     =  [vel(τ) for τ in τs]           # vector of function values f(τi)
	fxs     =  [pos(τ) for τ in τs]           # vector of function values f(τi)
	nfs     =  length(fjs)
	#--------------------------------------------------------------------------------
	# Fs = antiderivative from continuous function f(t)
	#                             +---------------------------------- function (!)
	#                             |
	#                             v
	Fa  = [accelerationFromJerk(jerk, nIntvs, -1.55, τ, c=0.0)[1] for τ in τs]
	Fv  = [velocityFromAcceleration(acc, nIntvs, 0.0, τ, c=0.0)[1] for τ in τs]
	Fx  = [positionFromVelocity(vel, nIntvs, 0.0, τ, c=1.0)[1] for τ in τs]
	#--------------------------------------------------------------------------------
	# Fvs = antiderivative from vector of function values fs
	Fav = 
		[accelerationFromJerk(
	#            +------------------------------------------------------ vector (!)
	#            |                                    
	#            v                                     
				fjs, Δτ, ntemp, c=-1.0)[1] for ntemp in 1:nfs]
	#-----------------------------------------------------------------------------
	Fvv = 
		[velocityFromAcceleration(
	#            +------------------------------------------------------ vector (!)
	#            |                                    
	#            v                                
				fas, Δτ, ntemp, c=0.0)[1] for ntemp in 1:nfs]
	#-----------------------------------------------------------------------------
	Fxv = 
		[positionFromVelocity(
	#            +------------------------------------------------------ vector (!)
	#            |                                   
	#            v                                  
			 	fvs, Δτ, ntemp, c=1.0)[1] for ntemp in 1:nfs]
	#--------------------------------------------------------------------------------
	plot(xlimits=[-0.02, 10.52], ylimits=[-1.12, 1.26], title=L"The\ Totality\ of\ Numerical\ Antiderivatives\ of\ SYO", titlefontsize=12, xlabel=L"τ", ylabel=L"F(τ), Fv(τ)") 
	#--------------------------------------------------------------------------------
	plot!(τs, jerk, lw=1.0, color=:red, label=L"theoretical\ j(τ)")
	plot!(τs, τ->acc(τ),  lw=1.0, color=:green, label=L"theoretical\ a(t)")
	plot!(τs, τ->vel(τ),  lw=1.0, color=:orange, label=L"theoretical\ v(t)")
	plot!(τs, τ->pos(τ),  lw=1.0, color=:blue, label=L"theoretical\ x(t)")
	#--------------------------------------------------------------------------------
	plot!(τs, Fa, lw=3.0, linestyle=:dot, color=:green, label=L"F_a(τ) \approx \int_0^τ f_j(τ') dτ'")
	plot!(τs, Fav, lw=2.0, linestyle=:dashdot, color=:green, label=L"F_a(τ) \approx c + \Delta x \sum_{i=1}^n f_j[i]")
	plot!(τs, Fv, lw=3.0, linestyle=:dot, color=:orange, label=L"F_v(τ) \approx \int_0^τ f_a(τ') dτ'")
	plot!(τs, Fvv, lw=2.0, linestyle=:dashdot, color=:orange, label=L"F_v(τ) \approx c + \Delta x \sum_{i=1}^n f_a[i]")
	plot!(τs, Fx, lw=3.0, linestyle=:dot, color=:cornflowerblue, label=L"F_x(τ) \approx \int_0^τ f_v(τ) dτ")
	plot!(τs, Fxv, lw=2.0, linestyle=:dashdot, color=:cornflowerblue, label=L"F_x(τ) \approx c + \Delta x \sum_{i=1}^n f_v[i]")
	#-------------------------------------------------------------------------------
end # let

# ╔═╡ 5cf4b041-70c4-4753-882f-384463c7405a
md"
---
###### 3.3 The Totality of *Iterated* Numerical *AntiDerivatives* of *Scotch-Yoke-Oscillator (SYO)*
Here, starting with $f_j(τ)=j(τ)$ we compute all *higher-order* or *iterated* antiderivatives $F_a(τ), F_v(τ), F_x(τ)$ in a *cascade*-like style. All but the first antiderivative have *vector* arguments instead of a *functional* argument.
"

# ╔═╡ e26273ab-388a-4371-8c4d-b37b18157432
let nIntvs  =  10^3                           # number of intervals
	τUpLim  =  2.0pi                          # upper integration limit τ
	Δτ      =  abs(0.0-τUpLim)/nIntvs
	τs      =  [τ for τ in 0.0+Δτ/2:Δτ:τUpLim-Δτ/2] 
	jerk(τ) =  sin(τ)                         # x'''(τ) = jerk in Scotch-Yoke-Oscill.
	acc(τ)  = -cos(τ)                         # acceleration
	Fas(τ)  =  acc(τ)                         # acceleration
	vel(τ)  = -sin(τ)                         # velocity
	pos(τ)  =  cos(τ)                         # position 
	fjs     =  [jerk(τ) for τ in τs]          # vector of function values f(τi)
	fas     =  [acc(τ) for τ in τs]           # vector of function values f(τi)
	fvs     =  [vel(τ) for τ in τs]           # vector of function values f(τi)
	fxs     =  [pos(τ) for τ in τs]           # vector of function values f(τi)
	nfs     =  length(fjs)
	#--------------------------------------------------------------------------------
	# Fvs = antiderivative from vector of function values fs
	Fav = 
		[accelerationFromJerk(
	#            +------------------------------------------------------ vector (!)
	#            |                                    
	#            v                                     
				fjs, Δτ, ntemp, c=-1.0)[1] for ntemp in 1:nfs]
	#-----------------------------------------------------------------------------
	Fvv = 
		[velocityFromAcceleration(
	#            +------------------------------------------------------ vector (!)
	#            |                                    
	#            v                                
				Fav, Δτ, ntemp, c=0.0)[1] for ntemp in 1:nfs]
	#-----------------------------------------------------------------------------
	Fxv = 
		[positionFromVelocity(
	#            +------------------------------------------------------ vector (!)
	#            |                                   
	#            v                                  
			 	fvs, Δτ, ntemp, c=1.0)[1] for ntemp in 1:nfs]
	#--------------------------------------------------------------------------------
