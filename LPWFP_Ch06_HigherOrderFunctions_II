###### 3.2.2 *Parallelized* Numerical Antiderivatives of  *Scotch-Yoke-Oscillator*
---
###### 3.2.2.1 *Acceleration* from *Jerk* in *Scotch-Yoke-Oscillator*
###### 1st *Method*: $F_a(t)=acceleration(t)$ with Function Parameter $f_j(t)=jerk(t)$

$F_a(t) = a(t) = a(0) + \int_0^t f_j(t') dt' \approx c + \Delta t \sum_{i=1}^t f_j(t_i)\;;\; t_i \le t$

"

# ╔═╡ b14d25e2-6c7c-4303-812e-f0a6e60454c2
# for continuous function jerkf
function accelerationFromJerk(
	jerkf::Function, n::Int64, a::Float64, t::Float64; c::Float64=0.0)::Tuple{Float64, Float64, Float64} 
	antiDerivative(jerkf, n, a, t, c = c)  
end # function accelerationFromJerk

# ╔═╡ 4f67e713-a943-45ec-9311-466dbbd39cbd
md"
---
###### 3rd Method: $F(x)$ with *Vector* Parameter of Discretized *Function* Values

$F_a(t) = a(t) = a(0) + \int_0^τ f_j(τ') dτ' \approx c + \Delta t \sum_{i=1}^n [...,f_j[i],...]$

where: 

$f_j[i] = f_j(τ_i),$

$a + \frac{\Delta τ}{2} \le j_i \le b - \frac{\Delta τ}{2},$ 

$τ_{i+1} = x_i + \Delta τ.$

"

# ╔═╡ eb8bc22e-01ca-4d16-ada3-21e41040b714
# for vector jerkV of discretisized function values jerkf
function accelerationFromJerk(
	jerkV::Vector{Float64}, Δτ::Float64, ntemp::Int64; c::Float64=0.0)::Tuple{Float64, Float64, Float64} 
	antiDerivative(jerkV, Δτ, ntemp, c = c)
end # function accelerationFromJerk

# ╔═╡ fbe09885-e8d0-42a0-b322-17c222e12a51
md"
---
###### 3.2.2.2 *Velocity* from *Acceleration* in *Scotch-Yoke-Oscillator*

###### 1st *Method*: $F(x)=velocity(t)$ with Function Parameter $f(x)=acceleration(t)$

$F_v(t) = v(t) = v(0) + \int_0^t f_a(t') dt' \approx c + \Delta t \sum_{i=1}^t f_a(t_i)\;;\; t_i \le t$

"

# ╔═╡ 4849625e-8faf-41d8-a850-ba193a3738e2
# for continuous function acc    # ------------------------------- 1st method
function velocityFromAcceleration(
#                             +----------------------------------- lower limit a
#                             |           +----------------------- upper limit b = t 
#                             |           |
#                             v           v
	accf::Function, n::Int64, a::Float64, t::Float64; c::Float64=0.0)::Tuple{Float64, Float64, Float64}  
	antiDerivative(accf, n, a, t, c = c)
end # function velocityFromAcceleration

# ╔═╡ a23d81c6-d121-4a11-bd26-998f451e9083
md"
---
###### 3rd Method: $F(x)$ with *Vector* of Discretized *Function* Values Parameter

$F_v(τ) = v(τ) = v(0) + \int_0^τ f_a(τ') dτ' \approx c + Δτ \sum_{i=1}^n [...,f_a[i],...]$

where: 

$f_a[i] = f_a(τ_i),$

$a + \frac{Δτ}{2} \le x_i \le b - \frac{Δτ}{2},$ 

$a_{i+1} = a_i + Δτ$
"

# ╔═╡ 10cef37f-5d01-4fd2-bd45-d546e30938a8
