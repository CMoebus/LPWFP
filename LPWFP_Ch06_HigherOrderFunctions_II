# ╔═╡ 602a632e-c190-47a5-b9a3-e04057f02e37
md"
---
###### 3.1 Numerical *Quadrature*
---
###### 1st Method: Definite Integral F(x) = $\int_a^b f(x)dx$ from Closed Form *Continuous Function* $f(x)$

$\left.F(x)\right|_a^b = \int_a^b f(x)dx \approx c + \Delta x \sum_{i=1}^b f(x_i)$

$\Delta x = \frac{|a-b|}{n}\;;\;\text{ where } n = \text{ number of intervals}$

$a + \frac{\Delta x}{2} \le x_i \le b - \frac{\Delta x}{2},$ 

$x_{i+1} = x_i + \Delta x.$

"

# ╔═╡ 68178cf6-f516-4fe2-a002-e704ba116eb7
md"
###### Signature of *1st method* of *function* $myIntegral$

$myIntegral: \mathbb R \times \mathbb N  \times \mathbb R \times \mathbb R \rightarrow \mathbb R \times \mathbb R \times \mathbb R$
$myIntegral: (f, n, a, b, c) \mapsto (integral, Δx, interval)$
"

# ╔═╡ 2b98eb0a-ff15-4a94-8c23-8c154905cc02
function myIntegral(
	f::Function, n::Int64, a::Float64, b::Float64; c::Float64=0.0)::Tuple{Float64, Float64, Float64}  
	Δx  = abs(a-b)/n
	xs = a + Δx/2.0:Δx:b - Δx/2.0
	integral = c + Δx * sum([f(x) for x in xs])
	intervalLength = Δx * length(xs)       # == abs(a-b)
    integral, Δx, intervalLength
end # function myIntegral

# ╔═╡ 431c33a7-cdbe-4d64-8edd-b9962d83ec69
md"
---
###### 2nd Method: Approximation of Definite Integral from *Vector* of Discretized *Function* Values 

$\left.F(x)\right |_a^b \approx c + \Delta x\sum_{i=1}^n [...,f_x[i],...]$


where: 

$f_x[i] = f(x_i),$

$a + \frac{\Delta x}{2} \le x_i \le b - \frac{\Delta x}{2},$ 

$x_{i+1} = x_i + \Delta x,$

and

$[...,f_x[i],...] \;;\; i=1,...,n$ is the *vector* of function values and 

$length([...,f_x[i],...] = n$ 

is its *length* $n$ (= *number* $n$ of vector *components*).

There is a *constraint* between upper integration limit $x = b - a$, $length([...,f_x[i],...]\ and\ \Delta x$:

$x = length([...,f_x[i],...]) \cdot \Delta x = n \Delta x$

and mappings

$(x, \frac{1}{\Delta x}) \mapsto n \left(= length([...,f_x[i],...])\right)$

$(x, n) \mapsto \frac{x}{n} = \Delta x.$

"

# ╔═╡ f6711618-992e-4864-a577-cfd4d372db36
md"
###### Signature of *2nd method* of *function* $myIntegral$

$myIntegral: [...,\mathbb R,...] \times \mathbb N  \times \mathbb R \times \mathbb R \rightarrow \mathbb R \times \mathbb R \times \mathbb R$
$myIntegral: (fs, n, a, b, c) \mapsto (integral, Δx, interval)$
"

# ╔═╡ a8623a1b-4865-4264-9cbb-80a686798b4b
function myIntegral(
	fs::Vector{Float64}, n::Int64, a::Float64, b::Float64; c::Float64=0.0)::Tuple{Float64, Float64, Float64} 
	Δx  = abs(a-b)/n
	# value by generator, integration limit x
	integral = c + Δx * sum((f for f in fs))
	intervalLength = Δx * length(fs)  # == abs(a-b)
	integral, Δx, intervalLength
end # function myIntegral

# ╔═╡ a1916494-9b0f-4b03-a7c6-711185703859
md"
---
###### 3rd Method of Function $myIntegral$
"

# ╔═╡ 7980a71e-18b5-4159-bf42-bd204e2dd5c1
md"
###### Signature of *3rd method* of *function* $myIntegral$

$myIntegral: [...,\mathbb R,...] \times \mathbb R \times \mathbb N \rightarrow \mathbb R \times \mathbb R \times \mathbb R$
$myIntegral: (fs, Δx, ntemp, c) \mapsto (integral, Δx, interval)$
"

# ╔═╡ 22cbe868-6318-435b-94d6-1d002688bce8
function myIntegral(
	fs::Vector{Float64}, Δx::Float64, ntemp::Int64; c::Float64=0.0)::Tuple{Float64, Float64, Float64} 
	# value by generator, integration limit x
	fss      = [fs[i] for i in 1:ntemp]
	integral = c + Δx * sum(fss)
	intervalLength = Δx * length(fss)  
	integral, Δx, intervalLength
end # function myIntegral

